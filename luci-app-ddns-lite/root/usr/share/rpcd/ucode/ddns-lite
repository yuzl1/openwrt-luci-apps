#!/usr/bin/env ucode
'use strict';

import { cursor } from 'uci';
import { popen } from 'fs';

const uci = cursor();

function sh(cmd) {
	let out = '';
	const p = popen(cmd, 'r');
	if (p == null)
		return '';
	for (let line = p.read('line'); length(line); line = p.read('line'))
		out += line + '\n';
	return rtrim(out);
}

function get(section, option, fallback) {
	const value = uci.get('ddns-lite', section, option);
	return (value == null || value == '') ? fallback : value;
}

function family_domains(section) {
	let domains = uci.get('ddns-lite', section, 'domains') || [];
	const out = [];

	if (type(domains) != 'array')
		domains = [ domains ];

	for (let i = 0; i < length(domains); i++) {
		const name = trim(domains[i]);
		if (length(name))
			push(out, name);
	}

	return out;
}

const methods = {};

methods.status = {
	call: function() {
		const running = (sh("pgrep -f '/usr/bin/ddns-lite-update daemon$' 2>/dev/null") != '');
		const log = sh("logread 2>/dev/null | grep -i 'ddns-lite\\[' | tail -n 20");

		return { running: running, log: log };
	}
};

methods.service_control = {
	args: { action: '' },
	call: function(request) {
		const action = request.args.action;

		if (action != 'start' && action != 'stop' && action != 'restart')
			return { ok: false, error: 'Invalid action' };

		const out = sh('/etc/init.d/ddns-lite ' + action + ' 2>&1');

		return { ok: true, action: action, output: out };
	}
};

methods.apply = {
	call: function() {
		uci.load('ddns-lite');

		const auth_mode = get('settings', 'auth_mode', 'token');

		if (auth_mode == 'tc3') {
			const secret_id = get('settings', 'secret_id', '');
			const secret_key = get('settings', 'secret_key', '');
			if (!length(secret_id) || !length(secret_key))
				return { ok: false, error: 'Tencent Cloud SecretId and SecretKey are required.' };
			if (!length(sh('command -v openssl 2>/dev/null')))
				return { ok: false, error: 'TC3 authentication requires openssl-util. Install it with: opkg install openssl-util' };
		}
		else {
			const id = get('settings', 'username', '');
			const token = get('settings', 'password', '');
			if (!length(id) || !length(token))
				return { ok: false, error: 'DNSPod ID and API token are required.' };
		}

		let count = 0;

		if (get('ipv4', 'enabled', '0') == '1')
			count += length(family_domains('ipv4'));

		if (get('ipv6', 'enabled', '0') == '1')
			count += length(family_domains('ipv6'));

		if (count == 0)
			return { ok: false, error: 'Enable IPv4 or IPv6 and add at least one domain.' };

		uci.commit('ddns-lite');
		const out = sh('/etc/init.d/ddns-lite restart 2>&1');

		return { ok: true, entries: count, output: out };
	}
};

return { 'ddns-lite': methods };
