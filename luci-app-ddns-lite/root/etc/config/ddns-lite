
config settings 'settings'
	option provider 'dnspod'
	option auth_mode 'token'
	option interval '10'

config ipv4 'ipv4'
	option enabled '1'
	option source 'network'
	option url 'https://myip.ipip.net https://ddns.oray.com/checkip https://ip.3322.net https://4.ipw.cn https://v4.yinghualuo.cn/bejson'
	option network 'wan'
	option interface 'pppoe-wan'

config ipv6 'ipv6'
	option enabled '0'
	option source 'network'
	option url 'https://speed.neu6.edu.cn/getIP.php https://v6.ident.me https://6.ipw.cn https://v6.yinghualuo.cn/bejson'
	option network 'wan6'
	option interface 'pppoe-wan'
